{
  "version": 2,
  "buildCommand": "npx prisma db push --accept-data-loss && ./node_modules/.bin/tsc && node -e \"require('fs').copyFileSync('dist/vercel-serverless.js','dist/index.js')\"",
  "installCommand": "npm install --include=dev",
  "outputDirectory": "dist",
  "rewrites": [{ "source": "/(.*)", "destination": "/index.js" }],
  "regions": ["sin1"],
  "env": {
    "NODE_ENV": "production"
  }
}
