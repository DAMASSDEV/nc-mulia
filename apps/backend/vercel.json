{
  "version": 2,
  "functions": {
    "dist/index.js": {
      "includeFiles": "prisma/**"
    }
  },
  "buildCommand": "npm run vercel-build",
  "installCommand": "npm install --include=dev",
  "outputDirectory": "dist",
  "rewrites": [{ "source": "/(.*)", "destination": "/index.js" }],
  "regions": ["sin1"],
  "env": {
    "NODE_ENV": "production"
  }
}
