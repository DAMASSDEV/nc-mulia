generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id                  String             @id @default(cuid())
  name                String
  email               String             @unique
  phone               String?
  passwordHash        String             @map("password_hash")
  role                String             @default("USER")
  membershipStatus    String             @default("REGULAR") @map("membership_status")
  membershipExpiresAt DateTime?          @map("membership_expires_at")
  isActive            Boolean            @default(true) @map("is_active")
  createdAt           DateTime           @default(now()) @map("created_at")
  updatedAt           DateTime           @updatedAt @map("updated_at")
  auditLogs           AdminAuditLog[]
  bmiRecords          BmiRecord[]
  cartItems           CartItem?
  conversations       ChatConversation[]
  messages            ChatMessage[]
  consultations       Consultation[]
  payments            Payment[]
  transactions        Transaction[]
  userRoles           UserRole[]

  @@map("users")
}

model Role {
  id          String               @id @default(cuid())
  name        String               @unique
  slug        String               @unique
  description String?
  isSystem    Boolean              @default(false) @map("is_system")
  isActive    Boolean              @default(true) @map("is_active")
  createdAt   DateTime             @default(now()) @map("created_at")
  updatedAt   DateTime             @updatedAt @map("updated_at")
  navItems    RoleNavigationItem[]
  permissions RolePermission[]
  userRoles   UserRole[]

  @@map("roles")
}

model Permission {
  id          String           @id @default(cuid())
  key         String           @unique
  module      String
  action      String
  description String?
  createdAt   DateTime         @default(now()) @map("created_at")
  roles       RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String
  permissionId String
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId], map: "role_permissions_permissionId_fkey")
  @@map("role_permissions")
}

model UserRole {
  userId String
  roleId String
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@index([roleId], map: "user_roles_roleId_fkey")
  @@map("user_roles")
}

model NavigationItem {
  id                 String               @id @default(cuid())
  key                String               @unique
  label              String
  route              String?
  iconKey            String?
  section            String               @default("main")
  parentId           String?
  sortOrder          Int                  @default(0) @map("sort_order")
  isActive           Boolean              @default(true) @map("is_active")
  isSystem           Boolean              @default(false) @map("is_system")
  requiredPermission String?              @map("required_permission")
  audience           String               @default("ADMIN")
  createdAt          DateTime             @default(now()) @map("created_at")
  updatedAt          DateTime             @updatedAt @map("updated_at")
  parent             NavigationItem?      @relation("NavParent", fields: [parentId], references: [id])
  children           NavigationItem[]     @relation("NavParent")
  roleVisibility     RoleNavigationItem[]

  @@index([parentId], map: "navigation_items_parentId_fkey")
  @@map("navigation_items")
}

model RoleNavigationItem {
  roleId           String
  navigationItemId String
  navigationItem   NavigationItem @relation(fields: [navigationItemId], references: [id], onDelete: Cascade)
  role             Role           @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([roleId, navigationItemId])
  @@index([navigationItemId], map: "role_navigation_items_navigationItemId_fkey")
  @@map("role_navigation_items")
}

model AdminAuditLog {
  id          String   @id @default(cuid())
  actorUserId String   @map("actor_user_id")
  action      String
  module      String
  entityType  String?  @map("entity_type")
  entityId    String?  @map("entity_id")
  beforeData  String?  @map("before_data")
  afterData   String?  @map("after_data")
  metadata    String?
  ipAddress   String?  @map("ip_address")
  userAgent   String?  @map("user_agent")
  createdAt   DateTime @default(now()) @map("created_at")
  actor       User     @relation(fields: [actorUserId], references: [id])

  @@index([actorUserId], map: "admin_audit_logs_actor_user_id_fkey")
  @@map("admin_audit_logs")
}

model Discount {
  id        String   @id @default(cuid())
  key       String   @unique @map("discount_key")
  label     String
  rate      Float
  isActive  Boolean  @default(true) @map("is_active")
  isSystem  Boolean  @default(false) @map("is_system")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("discounts")
}

model MembershipPlan {
  id           String   @id @default(cuid())
  key          String   @unique
  name         String
  description  String?
  fee          Float    @default(0)
  durationDays Int      @default(365) @map("duration_days")
  discountRate Float    @default(0.3) @map("discount_rate")
  isActive     Boolean  @default(true) @map("is_active")
  isDefault    Boolean  @default(false) @map("is_default")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at")

  @@map("membership_plans")
}

model Product {
  id                       String            @id @default(cuid())
  name                     String
  category                 String
  description              String
  benefits                 String?
  price                    Float
  imageUrl                 String?           @map("image_url")
  isAvailable              Boolean           @default(true) @map("is_available")
  isMemberDiscountEligible Boolean           @default(true) @map("is_member_discount_eligible")
  isActive                 Boolean           @default(true) @map("is_active")
  createdAt                DateTime          @default(now()) @map("created_at")
  updatedAt                DateTime          @updatedAt @map("updated_at")
  stock                    Int               @default(0)
  cartProducts             CartProduct[]
  transactionItems         TransactionItem[]

  @@map("products")
}

model CartItem {
  id        String        @id @default(cuid())
  userId    String        @unique @map("user_id")
  updatedAt DateTime      @updatedAt @map("updated_at")
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     CartProduct[]

  @@map("cart_items")
}

model CartProduct {
  id         String   @id @default(cuid())
  cartItemId String   @map("cart_item_id")
  productId  String   @map("product_id")
  quantity   Int      @default(1)
  cartItem   CartItem @relation(fields: [cartItemId], references: [id], onDelete: Cascade)
  product    Product  @relation(fields: [productId], references: [id])

  @@unique([cartItemId, productId])
  @@index([productId], map: "cart_products_product_id_fkey")
  @@map("cart_products")
}

model Transaction {
  id                       String            @id @default(cuid())
  userId                   String            @map("user_id")
  membershipStatusSnapshot String            @default("REGULAR") @map("membership_status_snapshot")
  normalTotal              Float             @map("normal_total")
  totalDiscount            Float             @map("total_discount")
  finalTotal               Float             @map("final_total")
  status                   String            @default("PENDING")
  createdAt                DateTime          @default(now()) @map("created_at")
  updatedAt                DateTime          @updatedAt @map("updated_at")
  payments                 Payment[]
  items                    TransactionItem[]
  user                     User              @relation(fields: [userId], references: [id])

  @@index([userId], map: "transactions_user_id_fkey")
  @@map("transactions")
}

model TransactionItem {
  id                 String      @id @default(cuid())
  transactionId      String      @map("transaction_id")
  productId          String      @map("product_id")
  productName        String      @map("product_name")
  quantity           Int
  basePrice          Float       @map("base_price")
  discountPercentage Float       @map("discount_percentage")
  discountAmount     Float       @map("discount_amount")
  finalUnitPrice     Float       @map("final_unit_price")
  subtotal           Float
  product            Product     @relation(fields: [productId], references: [id])
  transaction        Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)

  @@index([productId], map: "transaction_items_product_id_fkey")
  @@index([transactionId], map: "transaction_items_transaction_id_fkey")
  @@map("transaction_items")
}

model Consultation {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  question  String
  response  String?
  status    String   @default("PENDING")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  user      User     @relation(fields: [userId], references: [id])

  @@index([userId], map: "consultations_user_id_fkey")
  @@map("consultations")
}

model BmiRecord {
  id              String   @id @default(cuid())
  userId          String   @map("user_id")
  weight          Float
  height          Float
  bmi             Float
  bmiCategory     String   @map("bmi_category")
  recommendations String?  @map("recommendations")
  createdAt       DateTime @default(now()) @map("created_at")
  user            User     @relation(fields: [userId], references: [id])

  @@index([userId], map: "bmi_records_user_id_fkey")
  @@map("bmi_records")
}

model Payment {
  id              String      @id @default(cuid())
  transactionId   String      @map("transaction_id")
  userId          String      @map("user_id")
  method          String
  provider        String
  amount          Float
  referenceNumber String      @map("reference_number")
  paymentCode     String?     @map("payment_code")
  qrPayload       String?     @map("qr_payload")
  status          String      @default("PENDING")
  paidAt          DateTime?   @map("paid_at")
  expiresAt       DateTime    @map("expires_at")
  createdAt       DateTime    @default(now()) @map("created_at")
  updatedAt       DateTime    @updatedAt @map("updated_at")
  transaction     Transaction @relation(fields: [transactionId], references: [id])
  user            User        @relation(fields: [userId], references: [id])

  @@index([transactionId], map: "payments_transaction_id_fkey")
  @@index([userId], map: "payments_user_id_fkey")
  @@map("payments")
}

model ChatConversation {
  id              String        @id @default(cuid())
  userId          String        @map("user_id")
  customerName    String        @map("customer_name")
  category        String
  status          String        @default("OPEN")
  assignedAdminId String?       @map("assigned_admin_id")
  unreadByAdmin   Int           @default(0) @map("unread_by_admin")
  unreadByUser    Int           @default(0) @map("unread_by_user")
  lastMessageAt   DateTime      @default(now()) @map("last_message_at")
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")
  user            User          @relation(fields: [userId], references: [id])
  messages        ChatMessage[]

  @@index([userId], map: "chat_conversations_user_id_fkey")
  @@map("chat_conversations")
}

model ChatMessage {
  id             String           @id @default(cuid())
  conversationId String           @map("conversation_id")
  senderId       String           @map("sender_id")
  senderRole     String
  message        String
  readAt         DateTime?        @map("read_at")
  createdAt      DateTime         @default(now()) @map("created_at")
  conversation   ChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         User             @relation(fields: [senderId], references: [id])

  @@index([conversationId], map: "chat_messages_conversation_id_fkey")
  @@index([senderId], map: "chat_messages_sender_id_fkey")
  @@map("chat_messages")
}

model audience {
  id   Int    @id @default(autoincrement())
  name String @unique(map: "name_UNIQUE")

  @@map("_audience")
}
