{
  "version": 2,
  "buildCommand": "npm run build",
  "installCommand": "npm install",
  "framework": "vite",
  "devCommand": "npm run dev",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/api/(.*)", "destination": "https://nc-mulia-backend-dzakysyaam-dzakysyaams-projects.vercel.app/api/$1" },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "regions": ["sin1"],
  "env": {
    "VITE_API_URL": "https://nc-mulia-backend-dzakysyaam-dzakysyaams-projects.vercel.app",
    "VITE_SOCKET_URL": "https://nc-mulia-backend-dzakysyaam-dzakysyaams-projects.vercel.app"
  }
}
